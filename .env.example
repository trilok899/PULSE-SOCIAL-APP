# Server
NODE_ENV=development
PORT=5000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=pulse_social

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: Email (welcome mail and failure notices)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pulse.app
ADMIN_EMAIL=

# Automation worker (separate process, not used by the React app)
# Listener binds to 127.0.0.1. Leave AUTOMATION_API_KEY empty to keep /events closed.
AUTOMATION_HOST=127.0.0.1
AUTOMATION_PORT=5055
AUTOMATION_API_KEY=
AUTOMATION_TIMEZONE=Asia/Kolkata
AUTOMATION_MAX_RETRIES=3
AUTOMATION_ATTEMPT_TIMEOUT_MS=30000
NOTIFICATION_RETENTION_DAYS=30

# Optional: Cloudinary or file storage
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=